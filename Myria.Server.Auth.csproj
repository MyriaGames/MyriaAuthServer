<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The project/solution file is Myria.Server.Auth, but the published binary keeps the
         historic "MyriaAuthServer" name: Myria.Server.Realm's run-production.sh (shipped
         inside the release zip) hardcodes ./auth/MyriaAuthServer. -->
    <AssemblyName>MyriaAuthServer</AssemblyName>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- appsettings.Production.json holds real secrets on this dev machine (gitignored) —
         the Web SDK publishes appsettings.*.json to the output by default, which would ship
         it inside the release zip. Keep it usable for local `dotnet run`/`dotnet build`
         (CopyToOutputDirectory, untouched) but exclude it specifically from `dotnet publish`
         output. Real production config must come from environment variables at deploy time. -->
    <Content Update="appsettings.Production.json">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
